# ── FireX backend (copy to .env, fill YOUR OWN values; .env kabhi commit na karein) ──
PORT=3000
FIREBASE_PROJECT_ID=new-firex
# ⚠️ CLOUD STORAGE / STORAGE BUCKET KI ZARURAT NAHI — 2026-02-03 se Firebase
#    Cloud Storage Blaze (paid) plan maangta hai. Images Firestore (Spark-free)
#    me store hoti hain aur /api/media/:id se serve hoti hain. Koi card nahi.

# Service account ka PATH (file repo ke bahar rakhein) YA inline JSON env var
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}   ← Render ke liye ye aasan hai

# Optional: agar images ka URL alag host par chahiye (default = same origin)
# PUBLIC_URL=https://firex-xxxx.onrender.com

# Ek baar ka owner setup — lambi random string, use karke .env se hata dein
BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# ── PAYMENT: UPI QR · AUTO · koi manual approval nahi ────────────────────────
# upiqr      = DEFAULT. Dynamic UPI QR + upi://pay intent. FamPay, GPay,
#              PhonePe, Paytm, BHIM sab se open hota hai. Zero config, zero fee.
# simulation = purana test mode (same auto-credit, label alag)
# razorpay   = hosted checkout + signed webhook (KYC + ~2% fee)
PAYMENT_PROVIDER=upiqr

# Apna UPI VPA — yahin paise aayenge. QR isi par banta hai.
MERCHANT_UPI_ID=yourname@upi
MERCHANT_NAME=FireX Esports

# true = user ke pay karte hi wallet me coins auto-add (koi admin/UTR/screenshot nahi)
UPI_AUTO_CREDIT=true
ORDER_TTL_MS=480000
WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# ── OPTIONAL: real UPI PSP (sirf real money ke liye) ─────────────────────────
# In 2 line bharne se server credit karne se PEHLE gateway se status verify karta
# hai. Code me koi badlaav nahi — bas .env. Chhod diya to zero-config dynamic QR
# chalega (UPI app ka callback proof maana jata hai).
# UPIQR_BASE_URL=https://your-upi-provider.example
# UPIQR_API_KEY=xxx

# Razorpay (sirf PAYMENT_PROVIDER=razorpay par)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# NOTE: real-money gaming (entry fee / prize pool) me KYC aur gateway ToS
# restrictions ho sakte hain — live lene se pehle provider se verify kar lein.
